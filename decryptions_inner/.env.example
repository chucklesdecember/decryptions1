# Copy to .env (git-ignored) for local development. Same names go into Vercel.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Cloudflare Turnstile site key (bot protection on login/sign-up). Leave empty to hide the widget.
VITE_TURNSTILE_SITE_KEY=
# Optional analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
